# ─────────────────────────────────────────────────────────────────────────────
# MILI — variables d'environnement
# Copiez ce fichier en « .env » pour travailler en local.
# En production, saisissez ces valeurs dans Vercel (Settings → Environment
# Variables). Ne mettez JAMAIS de vraie clé dans ce fichier ni dans le dépôt.
# ─────────────────────────────────────────────────────────────────────────────

# Base de données PostgreSQL (Neon, Supabase, Vercel Postgres…)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mili?sslmode=require"

# Adresse publique du site, sans barre finale
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Deux secrets différents, 32 caractères minimum. Générer avec : openssl rand -hex 32
# Changer APP_SECRET invalide tous les liens personnels déjà envoyés par e-mail.
APP_SECRET=""
BETTER_AUTH_SECRET=""

# Secret de la tâche planifiée. Vercel l'envoie automatiquement à /api/cron/emails.
CRON_SECRET=""

# Premier compte Super Admin, créé par « npm run db:seed » (mot de passe : 12 caractères minimum).
# À retirer des variables une fois le compte créé.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# E-mails (Resend). Sans RESEND_API_KEY, aucun e-mail ne part et le back-office l'affiche.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="MILI <hello@votre-domaine.com>"
EMAIL_REPLY_TO=""

# Stockage des fichiers (images, fichiers des défis).
# « local » : dossier .storage, pour le développement uniquement.
# « s3 »    : obligatoire en production (Cloudflare R2, AWS S3, Backblaze B2…). Le bucket doit rester PRIVÉ.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Taille maximale d'un fichier envoyé, en Mo (4 au plus : limite des fonctions Vercel).
UPLOAD_MAX_MB="4"
